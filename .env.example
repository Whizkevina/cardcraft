# ─── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Railway Postgres, local Postgres, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/cardcraft

# ─── Paystack ────────────────────────────────────────────────────────────────
# Get your keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ─── Google OAuth (optional — required for Google Sign-In) ───────────────────
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ─── Gmail SMTP (optional — email delivery simulated without these) ───────────
# Use a Gmail App Password (NOT your Gmail login password)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── App URL ─────────────────────────────────────────────────────────────────
APP_URL=http://127.0.0.1:5000

# ─── Session (required in production) ────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-secret-string

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=127.0.0.1

# Copy this file to `.env.local` for local development.
# E2E tests load `.env.test` via Playwright (see `.env.test.example`).
