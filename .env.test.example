# E2E test environment — copy to `.env.test` and fill in values.
# Do not commit `.env.test` (it is gitignored).
#
# IMPORTANT: Use a LOCAL test database only — never production Supabase.
# E2E tests reset data and change the admin password.

DATABASE_URL=postgresql://cardcraft:cardcraft@localhost:5432/cardcraft_test
SESSION_SECRET=test-session-secret-min-32-chars-long
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
E2E_BASE_URL=http://127.0.0.1:5000
E2E_RESET_DB=true

PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
APP_URL=http://127.0.0.1:5000

# Local Postgres setup (matches GitHub Actions CI):
#   createdb cardcraft_test
#   createuser cardcraft --pwprompt   # password: cardcraft
#   grant all privileges on database cardcraft_test to cardcraft;

# Escape hatch only for a dedicated REMOTE test DB (not production):
# E2E_ALLOW_REMOTE_DB=true
